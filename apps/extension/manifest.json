{
  "manifest_version": 3,
  "name": "selfhostauth",
  "version": "0.1.0",
  "description": "TOTP codes from your self-hosted selfhostauth server",
  "action": {
    "default_popup": "popup.html",
    "default_title": "selfhostauth",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["<all_urls>"]
}
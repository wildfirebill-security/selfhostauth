{
  "name": "@selfhostauth/extension",
  "version": "0.1.6",
  "private": true,
  "description": "selfhostauth browser extension (Chrome / Edge / Firefox MV3)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@selfhostauth/client": "workspace:*",
    "@selfhostauth/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}

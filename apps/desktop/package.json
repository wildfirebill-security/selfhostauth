{
  "name": "@selfhostauth/desktop",
  "version": "0.1.6",
  "private": true,
  "description": "selfhostauth desktop client (Windows / macOS / Linux)",
  "homepage": "https://github.com/wildfirebill-security/selfhostauth",
  "author": "selfhostauth contributors <https://github.com/wildfirebill-security/selfhostauth>",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --outfile=dist/main/preload.cjs && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg",
    "package:linux": "electron-builder --linux AppImage deb",
    "package": "electron-builder"
  },
  "dependencies": {
    "@selfhostauth/client": "workspace:*",
    "@selfhostauth/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
